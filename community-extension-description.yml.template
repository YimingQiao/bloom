extension:
  name: bloom
  description: Robust predicate transfer using Bloom and bitmap filters
  version: 0.0.1
  language: C++
  build: cmake
  license: MIT
  maintainers:
    - YimingQiao

repo:
  github: YimingQiao/bloom
  ref: <release-commit>

docs:
  hello_world: |
    LOAD bloom;
    SELECT current_setting('enable_rpt');
  extended_description: |
    Bloom combines sampling-based estimates with execution-guided robust
    predicate transfer. Sampling predicts useful transfers; Bloom applies one
    Bloom or bitmap filter, observes the resulting cardinalities, and then
    chooses the next step. This keeps transfer decisions adaptive and efficient.
