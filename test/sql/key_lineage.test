# name: test/sql/key_lineage.test
# description: complete composite keys, pending feedback and independent queries under L/C
# group: [sql]

require bloom

statement ok
SET bloom_seperate_lineage=true;

statement ok
CREATE TABLE lc_a(x INTEGER,y INTEGER);

statement ok
INSERT INTO lc_a VALUES (1,1),(2,2),(1,1),(NULL,1);

statement ok
CREATE TABLE lc_b(x INTEGER,y INTEGER,z INTEGER);

statement ok
INSERT INTO lc_b VALUES (1,1,10),(1,2,20),(2,2,20),(3,3,30),(NULL,1,10);

statement ok
CREATE TABLE lc_c(z INTEGER);

statement ok
INSERT INTO lc_c VALUES (10),(10);

query III rowsort
SELECT a.x,b.y,c.z FROM lc_a a JOIN lc_b b ON a.x=b.x AND a.y=b.y JOIN lc_c c ON b.z=c.z;
----
1	1	10
1	1	10
1	1	10
1	1	10

# The next query must not reuse tokens/filters describing the old relation.
statement ok
INSERT INTO lc_c VALUES (20);

query I
SELECT count(*) FROM lc_a a JOIN lc_b b ON a.x=b.x AND a.y=b.y JOIN lc_c c ON b.z=c.z;
----
5

# A narrower complete key does not inherit an arbitrary composite constraint.
query I
SELECT count(*) FROM lc_a a JOIN lc_b b ON a.x=b.x JOIN lc_c c ON b.z=c.z;
----
7

statement ok
DELETE FROM lc_c;

query I
SELECT count(*) FROM lc_a a JOIN lc_b b ON a.x=b.x AND a.y=b.y JOIN lc_c c ON b.z=c.z;
----
0

# Exercise physical transfers, including a complete composite key followed by
# a different key. Result-only checks on tiny tables can bypass Bloom entirely.
statement ok
CREATE TABLE lc_source AS
SELECT i::INTEGER id, (i % 7)::INTEGER bucket, i % 97 = 0 AS keep FROM range(10000) t(i);

statement ok
CREATE TABLE lc_target AS
SELECT i::INTEGER id, (i % 7)::INTEGER bucket, (3 * i)::INTEGER z FROM range(10000) t(i);

statement ok
CREATE TABLE lc_next AS
SELECT (3 * i)::INTEGER z, i % 5 = 0 AS keep FROM range(10000) t(i);

statement ok
CHECKPOINT;

statement ok
CALL enable_logging('Bloom', storage = 'memory');

statement ok
CALL truncate_duckdb_logs();

query II
SELECT count(*), sum(t.id)
FROM lc_source s JOIN lc_target t ON s.id = t.id AND s.bucket = t.bucket
JOIN lc_next n ON t.z = n.z WHERE s.keep AND n.keep;
----
21	101850

query II
SELECT coalesce(bool_or(info['key_count']::UBIGINT = 2), false) = current_setting('enable_bloom'),
       coalesce(bool_or(info['key_count']::UBIGINT = 1), false) = current_setting('enable_bloom')
FROM duckdb_logs_parsed('Bloom') WHERE event = 'transfer';
----
true	true

statement ok
CALL disable_logging();

statement ok
RESET bloom_seperate_lineage;
