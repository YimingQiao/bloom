# name: test/sql/bloom.test
# description: test bloom extension
# group: [sql]

require bloom

query I
SELECT current_setting('enable_bloom');
----
true

query T
SELECT current_setting('bloom_sample_cache_dir');
----
auto

query T
SELECT current_setting('bloom_memory_limit');
----
auto

query III
SELECT current_setting('bloom_sample_size'),
       current_setting('bloom_sample_memory_cache'),
       current_setting('bloom_late_materialize');
----
10000	true	false

statement ok
CREATE TABLE rpt_build(id INTEGER, payload VARCHAR);

statement ok
INSERT INTO rpt_build VALUES (1, 'one'), (2, 'two'), (3, 'three');

statement ok
CREATE TABLE rpt_probe(id INTEGER, keep BOOLEAN);

statement ok
INSERT INTO rpt_probe VALUES (2, true), (3, false), (4, true);

query II
SELECT b.id, b.payload
FROM rpt_build b
JOIN rpt_probe p ON b.id = p.id
WHERE p.keep
ORDER BY b.id;
----
2	two

statement ok
CREATE TABLE rpt_sparse_left AS
SELECT i::INTEGER id,
       (i * 2)::INTEGER middle_col,
       ('payload_' || i)::VARCHAR payload,
       (i % 7)::INTEGER tail_col
FROM range(10000) t(i);

statement ok
CREATE TABLE rpt_sparse_right AS
SELECT i::INTEGER id, (i % 100 = 0) keep
FROM range(10000) t(i);

query IIII
SELECT count(*), sum(l.id), sum(length(l.payload)), sum(l.tail_col)
FROM rpt_sparse_left l
JOIN rpt_sparse_right r ON l.id = r.id
WHERE r.keep AND l.middle_col >= 0;
----
100	495000	1188	296

# Bloom's large retained objects must use DuckDB's non-spill BufferAllocator.
# EXECUTE lazily optimizes the prepared statement, after which its physical
# plan keeps the rewritten memory scans alive until DEALLOCATE.
statement ok
SET bloom_sample_memory_cache = false;

statement ok
CREATE TEMP TABLE rpt_allocator_baseline AS
SELECT memory_usage_bytes AS bytes
FROM duckdb_memory()
WHERE tag = 'ALLOCATOR';

statement ok
PREPARE rpt_allocator_lifetime AS
SELECT count(*), sum(length(l.payload))
FROM rpt_sparse_left l
JOIN rpt_sparse_right r ON l.id = r.id
WHERE r.keep;

query II
EXECUTE rpt_allocator_lifetime;
----
100	1188

query I
SELECT (memory_usage_bytes - bytes > 65536)::INTEGER
FROM duckdb_memory(), rpt_allocator_baseline
WHERE tag = 'ALLOCATOR';
----
1

statement ok
CREATE TEMP TABLE rpt_allocator_retained AS
SELECT memory_usage_bytes - bytes AS bytes
FROM duckdb_memory(), rpt_allocator_baseline
WHERE tag = 'ALLOCATOR';

query I
SELECT temporary_storage_bytes
FROM duckdb_memory()
WHERE tag = 'ALLOCATOR';
----
0

statement ok
DEALLOCATE rpt_allocator_lifetime;

query II
SELECT (abs(memory_usage_bytes - bytes) <= 65536)::INTEGER,
       (temporary_storage_bytes = 0)::INTEGER
FROM duckdb_memory(), rpt_allocator_baseline
WHERE tag = 'ALLOCATOR';
----
1	1

# DuckDB can reduce an operator's temporary-memory reservation to zero. Bloom
# must then keep the original plan instead of materializing or spilling.
statement ok
SET debug_force_external = true;

statement ok
PREPARE rpt_allocator_fallback AS
SELECT count(*), sum(length(l.payload))
FROM rpt_sparse_left l
JOIN rpt_sparse_right r ON l.id = r.id
WHERE r.keep;

query II
EXECUTE rpt_allocator_fallback;
----
100	1188

query I
SELECT (memory_usage_bytes - baseline.bytes < retained.bytes)::INTEGER
FROM duckdb_memory(), rpt_allocator_baseline baseline, rpt_allocator_retained retained
WHERE tag = 'ALLOCATOR';
----
1

statement ok
DEALLOCATE rpt_allocator_fallback;

# DuckDB may retain or release one small allocator block around prepared-plan
# destruction. The materialized Bloom footprint measured above is larger than
# this tolerance, so the bound still detects retained transfer state.
query II
SELECT (abs(memory_usage_bytes - bytes) <= 65536)::INTEGER,
       (temporary_storage_bytes = 0)::INTEGER
FROM duckdb_memory(), rpt_allocator_baseline
WHERE tag = 'ALLOCATOR';
----
1	1

statement ok
SET debug_force_external = false;

statement ok
SET bloom_sample_memory_cache = true;

# EXPLAIN must preserve DuckDB's native scans instead of running Bloom's
# optimizer-time sampling and replacing them with COLUMN_DATA_SCAN nodes.
query II
EXPLAIN SELECT count(*)
FROM rpt_sparse_left l
JOIN rpt_sparse_right r ON l.id = r.id
WHERE r.keep;
----
physical_plan	<REGEX>:.*Seq Scan.*

query II
EXPLAIN ANALYZE SELECT count(*)
FROM rpt_sparse_left l
JOIN rpt_sparse_right r ON l.id = r.id
WHERE r.keep;
----
analyzed_plan	<REGEX>:.*Table Scan.*

# A zero Bloom budget must take the whole-query fallback before sampling or the
# first materialization. Keep this query non-volatile so it reaches the memory
# admission path rather than the volatile-expression guard below.
statement ok
SET bloom_memory_limit = '0B';

query II
SELECT count(*), sum(l.id)
FROM rpt_sparse_left l
JOIN rpt_sparse_right r ON l.id = r.id
WHERE r.keep;
----
100	495000

statement ok
SET bloom_memory_limit = 'auto';

# Prepared samples and row-id bitmaps must not inspect uncommitted table state:
# cached samples can omit local values, and local row IDs occupy a high,
# disjoint range. The complete Bloom scope must stay on DuckDB's original path.
statement ok
SET bloom_late_materialize = true;

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO rpt_sparse_left VALUES (10000, 20000, 'payload_10000', 4);

statement ok
INSERT INTO rpt_sparse_right VALUES (10000, true);

query III
SELECT count(*), sum(l.id), sum(length(l.payload))
FROM rpt_sparse_left l
JOIN rpt_sparse_right r ON l.id = r.id
WHERE r.keep;
----
101	505000	1201

statement ok
ROLLBACK;

statement ok
SET bloom_late_materialize = false;

# Sampling and transfer execute predicates during optimization. Volatile
# expressions must bypass Bloom even with memory available, or their side effects
# would occur once during optimization and again in the final query.
statement ok
CREATE SEQUENCE rpt_volatile_sequence START 1;

query I
SELECT count(*)
FROM rpt_sparse_left l
JOIN rpt_sparse_right r ON l.id = r.id
WHERE r.keep AND nextval('rpt_volatile_sequence') > 0;
----
100

query I
SELECT currval('rpt_volatile_sequence');
----
100

statement ok
SET threads = 8;

# A hash-join CTE is retained at 8 threads and executed by DuckDB's runtime
# query Executor.
query III
WITH rpt_cte AS MATERIALIZED (
    SELECT l.id, l.payload, l.tail_col
    FROM rpt_sparse_left l
    JOIN rpt_sparse_right r ON l.id = r.id
    WHERE r.keep
)
SELECT count(*), sum(a.id), sum(b.tail_col)
FROM rpt_cte a
JOIN rpt_cte b ON a.id = b.id;
----
100	495000	296

# Range joins create tasks through DuckDB's active query Executor, so this CTE
# must remain intact for runtime execution even though its inputs are tiny.
query I
WITH range_cte AS MATERIALIZED (
    SELECT count(*) AS n
    FROM rpt_build b
    JOIN rpt_probe p ON b.id < p.id
)
SELECT n FROM range_cte;
----
6

# Bloom is fail-closed outside its validated domain. These plans must be left
# untouched and retain DuckDB's native semantics.
query I
WITH RECURSIVE countdown(n) AS (
    SELECT 3
    UNION ALL
    SELECT n - 1 FROM countdown WHERE n > 1
)
SELECT sum(n) FROM countdown;
----
6

query II
SELECT b.id, correlated.v
FROM rpt_build b,
LATERAL (
    SELECT max(p.id) AS v
    FROM rpt_probe p
    WHERE p.id <= b.id
) correlated
ORDER BY b.id;
----
1	NULL
2	2
3	3

# LIST keys exercise the nested hash path. HashColumns must preserve the
# result vector's logical size so the Bloom build actually inserts every key.
statement ok
CREATE TABLE rpt_nested_left(k INTEGER[], payload VARCHAR);

statement ok
INSERT INTO rpt_nested_left VALUES ([1], 'one'), ([2], 'two'), ([3], 'three');

statement ok
CREATE TABLE rpt_nested_right(k INTEGER[], keep BOOLEAN);

statement ok
INSERT INTO rpt_nested_right VALUES ([2], true), ([3], false), ([4], true);

query TT
SELECT l.k, l.payload
FROM rpt_nested_left l
JOIN rpt_nested_right r ON l.k = r.k
WHERE r.keep
ORDER BY l.k;
----
[2]	two

# STRUCT keys exercise the other nested physical representation.
statement ok
CREATE TABLE rpt_struct_left(k STRUCT(a INTEGER), payload VARCHAR);

statement ok
INSERT INTO rpt_struct_left VALUES ({'a': 1}, 'one'), ({'a': 2}, 'two'), ({'a': 3}, 'three');

statement ok
CREATE TABLE rpt_struct_right(k STRUCT(a INTEGER), keep BOOLEAN);

statement ok
INSERT INTO rpt_struct_right VALUES ({'a': 2}, true), ({'a': 3}, false), ({'a': 4}, true);

query T
SELECT l.payload
FROM rpt_struct_left l
JOIN rpt_struct_right r ON l.k = r.k
WHERE r.keep
ORDER BY l.payload;
----
two

statement ok
CREATE TABLE rpt_array_left(k INTEGER[2], payload VARCHAR);

statement ok
INSERT INTO rpt_array_left VALUES ([1, 1], 'one'), ([2, 2], 'two'), ([3, 3], 'three');

statement ok
CREATE TABLE rpt_array_right(k INTEGER[2], keep BOOLEAN);

statement ok
INSERT INTO rpt_array_right VALUES ([2, 2], true), ([3, 3], false), ([4, 4], true);

query T
SELECT l.payload
FROM rpt_array_left l
JOIN rpt_array_right r ON l.k = r.k
WHERE r.keep;
----
two

statement ok
CREATE TABLE rpt_map_left(k MAP(INTEGER, INTEGER), payload VARCHAR);

statement ok
INSERT INTO rpt_map_left VALUES (map([1], [1]), 'one'), (map([2], [2]), 'two'), (map([3], [3]), 'three');

statement ok
CREATE TABLE rpt_map_right(k MAP(INTEGER, INTEGER), keep BOOLEAN);

statement ok
INSERT INTO rpt_map_right VALUES (map([2], [2]), true), (map([3], [3]), false), (map([4], [4]), true);

query T
SELECT l.payload
FROM rpt_map_left l
JOIN rpt_map_right r ON l.k = r.k
WHERE r.keep;
----
two

# DuckDB rewrites large IN lists into uniquely-owned CHUNK_GET collections.
# Bloom must keep an unfiltered collection under its original logical owner;
# replacing the node with a non-owning MemoryScan would leave a dangling CDC.
statement ok
CREATE TABLE rpt_chunk_sales(customer_id INTEGER, item_sk INTEGER, date_sk INTEGER, price INTEGER);

statement ok
INSERT INTO rpt_chunk_sales VALUES (1, 1, 1, 10), (2, 9, 1, 20);

statement ok
CREATE TABLE rpt_chunk_customer(customer_id INTEGER, address_id INTEGER);

statement ok
INSERT INTO rpt_chunk_customer VALUES (1, 1), (2, 2);

statement ok
CREATE TABLE rpt_chunk_address(address_id INTEGER, zip VARCHAR);

statement ok
INSERT INTO rpt_chunk_address VALUES (1, 'A'), (2, 'Z');

statement ok
CREATE TABLE rpt_chunk_date(date_sk INTEGER, year INTEGER);

statement ok
INSERT INTO rpt_chunk_date VALUES (1, 2001);

statement ok
CREATE TABLE rpt_chunk_item(item_sk INTEGER, item_id VARCHAR);

statement ok
INSERT INTO rpt_chunk_item VALUES (1, 'X'), (9, 'Y');

query II
SELECT count(*), sum(price)
FROM rpt_chunk_sales sales
JOIN rpt_chunk_customer customer ON sales.customer_id = customer.customer_id
JOIN rpt_chunk_address address ON customer.address_id = address.address_id
JOIN rpt_chunk_date dates ON sales.date_sk = dates.date_sk
JOIN rpt_chunk_item items ON sales.item_sk = items.item_sk
WHERE dates.year = 2001
  AND (address.zip IN ('A', 'B', 'C', 'D', 'E', 'F', 'G')
       OR items.item_id IN (
           SELECT item_id
           FROM rpt_chunk_item
           WHERE item_sk IN (1, 2, 3, 4, 5, 6, 7)
       ));
----
1	10

statement ok
UPDATE rpt_probe
SET keep = false
FROM rpt_build
WHERE rpt_probe.id = rpt_build.id AND rpt_build.id = 2;

query II
SELECT id, keep::INTEGER FROM rpt_probe ORDER BY id;
----
2	0
3	0
4	1

statement ok
UPDATE rpt_probe SET keep = true WHERE id = 2;

statement ok
SET threads = 1;

statement ok
SET enable_bloom = false;

query I
SELECT current_setting('enable_bloom');
----
false

query II
SELECT b.id, b.payload
FROM rpt_build b
JOIN rpt_probe p ON b.id = p.id
WHERE p.keep
ORDER BY b.id;
----
2	two

query IIII
SELECT count(*), sum(l.id), sum(length(l.payload)), sum(l.tail_col)
FROM rpt_sparse_left l
JOIN rpt_sparse_right r ON l.id = r.id
WHERE r.keep AND l.middle_col >= 0;
----
100	495000	1188	296

statement ok
