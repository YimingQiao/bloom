# name: test/sql/bloom.test
# description: test bloom extension
# group: [sql]

require bloom

query I
SELECT current_setting('enable_rpt');
----
true

query T
SELECT current_setting('rpt_sample_cache_dir');
----
auto

query III
SELECT current_setting('rpt_sample_size'),
       current_setting('rpt_sample_memory_cache'),
       current_setting('rpt_late_materialize');
----
10000	true	false

statement ok
CREATE TABLE rpt_build(id INTEGER, payload VARCHAR);

statement ok
INSERT INTO rpt_build VALUES (1, 'one'), (2, 'two'), (3, 'three');

statement ok
CREATE TABLE rpt_probe(id INTEGER, keep BOOLEAN);

statement ok
INSERT INTO rpt_probe VALUES (2, true), (3, false), (4, true);

query II
SELECT b.id, b.payload
FROM rpt_build b
JOIN rpt_probe p ON b.id = p.id
WHERE p.keep
ORDER BY b.id;
----
2	two

statement ok
CREATE TABLE rpt_sparse_left AS
SELECT i::INTEGER id,
       (i * 2)::INTEGER middle_col,
       ('payload_' || i)::VARCHAR payload,
       (i % 7)::INTEGER tail_col
FROM range(10000) t(i);

statement ok
CREATE TABLE rpt_sparse_right AS
SELECT i::INTEGER id, (i % 100 = 0) keep
FROM range(10000) t(i);

query IIII
SELECT count(*), sum(l.id), sum(length(l.payload)), sum(l.tail_col)
FROM rpt_sparse_left l
JOIN rpt_sparse_right r ON l.id = r.id
WHERE r.keep AND l.middle_col >= 0;
----
100	495000	1188	296

statement ok
SET threads = 8;

# A hash-join CTE is retained at 8 threads and executed by DuckDB's runtime
# query Executor.
query III
WITH rpt_cte AS MATERIALIZED (
    SELECT l.id, l.payload, l.tail_col
    FROM rpt_sparse_left l
    JOIN rpt_sparse_right r ON l.id = r.id
    WHERE r.keep
)
SELECT count(*), sum(a.id), sum(b.tail_col)
FROM rpt_cte a
JOIN rpt_cte b ON a.id = b.id;
----
100	495000	296

# Range joins create tasks through DuckDB's active query Executor, so this CTE
# must remain intact for runtime execution even though its inputs are tiny.
query I
WITH range_cte AS MATERIALIZED (
    SELECT count(*) AS n
    FROM rpt_build b
    JOIN rpt_probe p ON b.id < p.id
)
SELECT n FROM range_cte;
----
6

statement ok
SET threads = 1;

statement ok
SET enable_rpt = false;

query II
SELECT b.id, b.payload
FROM rpt_build b
JOIN rpt_probe p ON b.id = p.id
WHERE p.keep
ORDER BY b.id;
----
2	two

query IIII
SELECT count(*), sum(l.id), sum(length(l.payload)), sum(l.tail_col)
FROM rpt_sparse_left l
JOIN rpt_sparse_right r ON l.id = r.id
WHERE r.keep AND l.middle_col >= 0;
----
100	495000	1188	296
