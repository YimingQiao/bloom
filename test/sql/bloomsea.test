# name: test/sql/bloomsea.test
# description: test bloomsea extension
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT bloomsea('Sam');
----
Catalog Error: Scalar Function with name bloomsea does not exist!

# Require statement will ensure this test is run with this extension loaded
require bloomsea

# Confirm the extension works
query I
SELECT bloomsea('Sam');
----
...........🦆 Sam

query I
SELECT bloomsea_openssl_version('Michael') ILIKE 'Bloomsea Michael, my linked OpenSSL version is OpenSSL%';
----
true
