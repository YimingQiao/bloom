# name: test/sql/transfer/ubigint_filter.test
# description: transfer falls back to Bloom for unsigned keys outside signed range
# group: [transfer]

require bloom

statement ok
SET threads = 8;

statement ok
SET bloom_excitation_mode = 'join_key_ndv';

statement ok
CREATE TABLE rpt_ubigint_source AS
SELECT (9223372036854775808::UBIGINT + i::UBIGINT) k,
       i::INTEGER bridge,
       (i % 4 != 3) keep
FROM range(1000) t(i);

statement ok
CREATE TABLE rpt_ubigint_probe AS
SELECT (9223372036854775808::UBIGINT + i::UBIGINT) k
FROM range(1000) t(i);

statement ok
CREATE TABLE rpt_ubigint_anchor AS
SELECT i::INTEGER bridge
FROM range(1000) t(i);

statement ok
CREATE TABLE rpt_ubigint_edge AS
SELECT i::INTEGER bridge,
       (i % 4 != 3) keep
FROM range(1000) t(i);

query II
SELECT count(*), sum(s.bridge)
FROM rpt_ubigint_probe p
JOIN rpt_ubigint_source s ON p.k = s.k
JOIN rpt_ubigint_anchor a ON s.bridge = a.bridge
JOIN rpt_ubigint_edge e ON a.bridge = e.bridge
WHERE s.keep AND e.keep;
----
750	374250
