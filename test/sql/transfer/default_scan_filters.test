# name: test/sql/transfer/default_scan_filters.test
# description: transfer filters respect scan types and subtree output bindings
# group: [transfer]

require bloom

statement ok
CREATE TABLE rpt_output_layout(id INTEGER, s STRUCT(a INTEGER, b VARCHAR), x INTEGER);

statement ok
INSERT INTO rpt_output_layout VALUES (1, {'a': 1, 'b': NULL}, 10), (2, {'a': 2, 'b': 'y'}, 20);

statement ok
CHECKPOINT;

# DuckDB late materialization introduces a rowid join and a projection below
# TOP_N. A filter on its output rowid must not become a filter on scan column id.
query II
SELECT s, x FROM rpt_output_layout WHERE s.a = 1 ORDER BY id LIMIT 1;
----
{'a': 1, 'b': NULL}	10

query II
SELECT s, x FROM rpt_output_layout WHERE s.a = 2 ORDER BY id LIMIT 1;
----
{'a': 2, 'b': y}	20

# The same result without the rowid-join rewrite.
statement ok
SET disabled_optimizers = 'late_materialization';

query II
SELECT s, x FROM rpt_output_layout WHERE s.a = 1 ORDER BY id LIMIT 1;
----
{'a': 1, 'b': NULL}	10

statement ok
SET disabled_optimizers = '';

# Moving a transfer filter below a LIMIT can admit rows outside the original
# limited result. Evaluate it on the subtree output instead.
statement ok
CREATE TABLE rpt_output_probe AS SELECT i::INTEGER id FROM range(100) t(i);

statement ok
CREATE TABLE rpt_output_keys AS SELECT i::INTEGER id FROM range(50, 100) t(i);

statement ok
CHECKPOINT;

query I
SELECT count(*) FROM (SELECT id FROM rpt_output_probe ORDER BY id LIMIT 20) a
JOIN rpt_output_keys b USING (id);
----
0

# Statistics can add a range FILTER after the scan already has local filters.
# Adding storage pruning must preserve the row-level range check and output
# projection, including when filter-only columns precede the returned columns.
statement ok
CREATE TABLE rpt_range_source AS
SELECT i % 2 = 0 AS keep, repeat('unused', 8) filler,
       ('value_' || i)::VARCHAR payload, i::INTEGER id
FROM range(10000) t(i);

statement ok
CREATE TABLE rpt_range_keys AS SELECT i::INTEGER id FROM range(2, 5000) t(i);

statement ok
CHECKPOINT;

statement ok
CALL enable_logging('Bloom', storage = 'memory');

statement ok
CALL truncate_duckdb_logs();

query IIT
SELECT count(*), sum(s.id), min(s.payload)
FROM rpt_range_source s JOIN rpt_range_keys k USING (id)
WHERE s.keep;
----
2499	6247500	value_10

query I
SELECT coalesce(max(completed_sources) > 0, false) = current_setting('enable_bloom')
FROM duckdb_logs_parsed('Bloom') WHERE event = 'transfer_complete';
----
true

statement ok
CALL disable_logging();

statement ok
SET enable_bloom = false;

query IIT
SELECT count(*), sum(s.id), min(s.payload)
FROM rpt_range_source s JOIN rpt_range_keys k USING (id)
WHERE s.keep;
----
2499	6247500	value_10
