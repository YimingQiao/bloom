# name: test/sql/transfer/computed_join_key.test
# description: transfer filters respect computed keys above an inner join
# group: [transfer]

require bloom

statement ok
SET threads=1;

statement ok
SET bloom_sample_mode='instant';

statement ok
SET bloom_sample_seed=2;

statement ok
SET disabled_optimizers='join_order,build_side_probe_side';

statement ok
CREATE TABLE fractions AS
SELECT i AS id, (i % 1000 + 0.25)::DOUBLE AS k FROM range(100000) t(i);

statement ok
CREATE TABLE ids AS SELECT i AS id FROM range(100000) t(i);

statement ok
CREATE TABLE lookup_keys AS
SELECT (i % 1000)::DOUBLE AS k, i % 100 AS flag FROM range(100000) t(i);

# The fractional base values never equal the integer-valued lookup keys.
query I
SELECT count(*)
FROM (SELECT (k::BIGINT)::DOUBLE AS k FROM fractions JOIN ids USING (id)) rounded
JOIN lookup_keys USING (k)
WHERE lookup_keys.flag=7;
----
100000

query I
SELECT count(*)
FROM (SELECT CASE WHEN k < 5 THEN 0::DOUBLE ELSE 1::DOUBLE END AS k
      FROM fractions JOIN ids USING (id)) classified
JOIN lookup_keys USING (k)
WHERE lookup_keys.k=1;
----
9950000
