# name: test/sql/sampling_edge_cases.test
# description: exercise sampling fallbacks, cache identity, and task lifetimes
# group: [sql]

require bloom

require parquet

# Every public sampling budget rejects zero before it can create empty task or
# allocation state.
statement error
SET rpt_instant_access_points = 0;
----
rpt_instant_access_points must be between 1 and 1000000

statement error
SET rpt_instant_rows_per_access = 0;
----
rpt_instant_rows_per_access must be between 1 and 1000000

statement error
SET rpt_instant_block_windows = 0;
----
rpt_instant_block_windows must be between 1 and 1000000

statement error
SET rpt_instant_parquet_row_groups = 0;
----
rpt_instant_parquet_row_groups must be between 1 and 1000000

statement error
SET rpt_excitation_threshold = 1.1;
----
rpt_excitation_threshold must be finite and between 0 and 1

# Build persistent native tables with enough vectors to schedule several
# instant-sampling and RPT materialization tasks per optimization.
statement ok
CREATE TABLE sampling_lifecycle_a AS
SELECT i::INTEGER id, (i * 3)::BIGINT payload
FROM range(12000) t(i);

statement ok
CREATE TABLE sampling_lifecycle_b AS
SELECT i::INTEGER id, (i % 5 = 0) keep
FROM range(12000) t(i);

statement ok
CREATE TABLE sampling_lifecycle_c AS
SELECT i::INTEGER id
FROM range(12000) t(i);

statement ok
CHECKPOINT;

statement ok
SET rpt_sample_mode = 'instant';

statement ok
SET rpt_instant_access = 'scattered';

statement ok
SET rpt_sample_size = 257;

statement ok
SET rpt_instant_access_points = 8;

statement ok
SET rpt_instant_rows_per_access = 257;

# With no background async workers, every scheduled task must be drained by
# the caller. Repetition catches tasks that outlive their stack-owned executor.
statement ok
SET async_threads = 0;

loop i 0 20

query II
SELECT count(*), sum(a.id)
FROM sampling_lifecycle_a a
JOIN sampling_lifecycle_b b USING (id)
JOIN sampling_lifecycle_c c USING (id)
WHERE b.keep AND a.payload >= 0;
----
2400	14394000

endloop

# Repeat with background workers so completion and cancellation race with the
# caller-side WorkOnTasks path.
statement ok
SET async_threads = 4;

loop i 0 20

query II
SELECT count(*), sum(a.id)
FROM sampling_lifecycle_a a
JOIN sampling_lifecycle_b b USING (id)
JOIN sampling_lifecycle_c c USING (id)
WHERE b.keep AND a.payload >= 0;
----
2400	14394000

endloop

# The block/prefetch policy has a separate task executor.
statement ok
SET rpt_instant_access = 'block';

query II
SELECT count(*), sum(a.id)
FROM sampling_lifecycle_a a
JOIN sampling_lifecycle_b b USING (id)
JOIN sampling_lifecycle_c c USING (id)
WHERE b.keep AND a.payload >= 0;
----
2400	14394000

# Empty inputs and a full sample with zero local survivors must not divide by
# zero or turn an uncertain partial sample into an invalid execution result.
statement ok
CREATE TABLE sampling_empty(id INTEGER);

statement ok
CREATE TABLE sampling_small_b AS
SELECT i::INTEGER id, false AS keep FROM range(17) t(i);

statement ok
CREATE TABLE sampling_small_c AS
SELECT i::INTEGER id FROM range(17) t(i);

query I
SELECT count(*)
FROM sampling_empty a
JOIN sampling_small_b b USING (id)
JOIN sampling_small_c c USING (id)
WHERE b.keep;
----
0

statement ok
CREATE TABLE sampling_zero_a AS
SELECT i::INTEGER id FROM range(257) t(i);

statement ok
CREATE TABLE sampling_zero_b AS
SELECT i::INTEGER id, false AS keep FROM range(257) t(i);

statement ok
CREATE TABLE sampling_zero_c AS
SELECT i::INTEGER id FROM range(257) t(i);

query I
SELECT count(*)
FROM sampling_zero_a a
JOIN sampling_zero_b b USING (id)
JOIN sampling_zero_c c USING (id)
WHERE b.keep;
----
0

# Direct native sampling intentionally rejects nested physical layouts. The
# estimator must fall back without changing the formal query result.
statement ok
CREATE TABLE sampling_nested_a(k INTEGER[], payload VARCHAR);

statement ok
INSERT INTO sampling_nested_a VALUES ([1], 'one'), ([2], 'two'), ([3], 'three');

statement ok
CREATE TABLE sampling_nested_b(k INTEGER[], keep BOOLEAN);

statement ok
INSERT INTO sampling_nested_b VALUES ([2], true), ([3], false), ([4], true);

statement ok
CREATE TABLE sampling_nested_c(k INTEGER[]);

statement ok
INSERT INTO sampling_nested_c VALUES ([1]), ([2]), ([3]), ([4]);

statement ok
SET rpt_instant_access = 'scattered';

query T
SELECT a.payload
FROM sampling_nested_a a
JOIN sampling_nested_b b USING (k)
JOIN sampling_nested_c c USING (k)
WHERE b.keep
ORDER BY a.payload;
----
two

# file_row_number is file-relative. A multi-file Parquet scan is therefore an
# unsupported instant source and must use the estimator fallback.
statement ok
COPY (
    SELECT i::INTEGER id FROM range(0, 1000) t(i)
) TO '{TEST_DIR}/sampling_multi_left_0.parquet' (FORMAT PARQUET);

statement ok
COPY (
    SELECT i::INTEGER id FROM range(1000, 2000) t(i)
) TO '{TEST_DIR}/sampling_multi_left_1.parquet' (FORMAT PARQUET);

statement ok
COPY (
    SELECT i::INTEGER id, (i % 7 = 0) keep FROM range(0, 1000) t(i)
) TO '{TEST_DIR}/sampling_multi_right_0.parquet' (FORMAT PARQUET);

statement ok
COPY (
    SELECT i::INTEGER id, (i % 7 = 0) keep FROM range(1000, 2000) t(i)
) TO '{TEST_DIR}/sampling_multi_right_1.parquet' (FORMAT PARQUET);

query II
SELECT count(*), sum(l.id)
FROM read_parquet([
    '{TEST_DIR}/sampling_multi_left_0.parquet',
    '{TEST_DIR}/sampling_multi_left_1.parquet'
]) l
JOIN read_parquet([
    '{TEST_DIR}/sampling_multi_right_0.parquet',
    '{TEST_DIR}/sampling_multi_right_1.parquet'
]) r USING (id)
WHERE r.keep;
----
286	285285

# Prepared cache identity includes the target size as well as the seed. A
# preload for a new target must not consume or rebuild the previous samples.
statement ok
SET rpt_sample_mode = 'prepared';

statement ok
SET rpt_sample_cache_dir = '{TEST_DIR}/sampling_target_cache';

statement ok
SET rpt_sample_memory_cache = false;

statement ok
ATTACH '{TEST_DIR}/sampling_target.db' AS sampling_target;

statement ok
CREATE TABLE sampling_target.a AS
SELECT i::INTEGER id, (i * 2)::INTEGER payload FROM range(2048) t(i);

statement ok
CREATE TABLE sampling_target.b AS
SELECT i::INTEGER id, (i % 2 = 0) keep FROM range(2048) t(i);

statement ok
CREATE TABLE sampling_target.c AS
SELECT i::INTEGER id FROM range(2048) t(i);

statement ok
CHECKPOINT;

statement ok
SET rpt_sample_size = 31;

query I
SELECT count(*)
FROM sampling_target.a a
JOIN sampling_target.b b USING (id)
JOIN sampling_target.c c USING (id)
WHERE b.keep AND a.payload >= 0;
----
1024

query I
SELECT count(*) FROM glob('{TEST_DIR}/sampling_target_cache/*.sample');
----
3

query I
SELECT loaded_samples FROM rpt_preload_samples();
----
3

statement ok
SET rpt_sample_size = 32;

query I
SELECT loaded_samples FROM rpt_preload_samples();
----
0

query I
SELECT count(*)
FROM sampling_target.a a
JOIN sampling_target.b b USING (id)
JOIN sampling_target.c c USING (id)
WHERE b.keep AND a.payload >= 0;
----
1024

query I
SELECT count(*) FROM glob('{TEST_DIR}/sampling_target_cache/*.sample');
----
6

query I
SELECT loaded_samples FROM rpt_preload_samples();
----
3

