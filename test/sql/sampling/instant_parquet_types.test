# name: test/sql/sampling/instant_parquet_types.test
# description: sample nullable and non-numeric Parquet columns
# group: [sampling]

require bloom

require parquet

statement ok
SET rpt_sample_mode = 'instant';

statement ok
SET rpt_sample_size = 257;

statement ok
SET rpt_instant_parquet_row_groups = 3;

statement ok
SET threads = 4;

statement ok
COPY (
    SELECT CASE WHEN i % 17 = 0 THEN NULL ELSE 'key_' || i::VARCHAR END join_key,
           (i::DECIMAL(18, 2) + 0.25)::DECIMAL(18, 2) amount,
           CASE WHEN i % 13 = 0 THEN NULL ELSE (i % 4)::VARCHAR END tag
    FROM range(10000) t(i)
) TO '{TEST_DIR}/rpt_parquet_types_left.parquet' (FORMAT PARQUET, ROW_GROUP_SIZE 4096);

statement ok
COPY (
    SELECT CASE WHEN i % 17 = 0 THEN NULL ELSE 'key_' || i::VARCHAR END join_key,
           i % 10 = 0 keep,
           DATE '2020-01-01' + (i % 31)::INTEGER event_date
    FROM range(10000) t(i)
) TO '{TEST_DIR}/rpt_parquet_types_right.parquet' (FORMAT PARQUET, ROW_GROUP_SIZE 4096);

query ITTT
SELECT count(*), sum(l.amount), min(r.event_date), max(r.event_date)
FROM read_parquet('{TEST_DIR}/rpt_parquet_types_left.parquet') l
JOIN read_parquet('{TEST_DIR}/rpt_parquet_types_right.parquet') r USING (join_key)
WHERE r.keep
  AND (l.tag IS NULL OR l.tag = '0')
  AND r.event_date >= DATE '2020-01-10';
----
358	1811459.50	2020-01-10	2020-01-31
