# name: test/sql/sampling/instant_parquet_multifile_union.test
# description: preserve union-by-name projection semantics in isolated file samples
# group: [sampling]

require bloom

require parquet

statement ok
SET rpt_sample_mode = 'instant';

statement ok
SET rpt_sample_size = 257;

statement ok
COPY (
    SELECT i::INTEGER id, (i % 5)::INTEGER a
    FROM range(0, 1000) t(i)
) TO '{TEST_DIR}/rpt_multi_union_0.parquet' (FORMAT PARQUET);

statement ok
COPY (
    SELECT i::INTEGER id, (i % 5)::INTEGER b
    FROM range(1000, 2000) t(i)
) TO '{TEST_DIR}/rpt_multi_union_1.parquet' (FORMAT PARQUET);

statement ok
CREATE TABLE rpt_multi_union_ids AS
SELECT i::INTEGER id FROM range(2000) t(i);

query I
SELECT count(*)
FROM read_parquet([
    '{TEST_DIR}/rpt_multi_union_0.parquet',
    '{TEST_DIR}/rpt_multi_union_1.parquet'
], union_by_name = true) p
JOIN rpt_multi_union_ids ids USING (id)
WHERE coalesce(p.a, p.b) < 2;
----
800
